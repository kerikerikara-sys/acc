# ======================================================================
#  CONFIGURACION DEL SERVIDOR API NOXXER
# ======================================================================

# PUERTO EN EL QUE ESCUCHA EL API
# Si ya tienes abierto otro puerto (ej: 30120), usalo para no pelearte con firewalls
# Si cambias esto, tambien tendras que abrir este puerto en el firewall
# de tu VPS (UFW / Windows Firewall / Security Groups)
PORT=30120

# INTERFAZ / IP EN LA QUE ESCUCHA EL SERVIDOR
# - "0.0.0.0" = acepta conexiones desde CUALQUIER IP (usa esto en VPS)
# - "127.0.0.1" = solo conexiones locales (solo la propia maquina)
# - "192.168.x.x" = solo tu red LAN
# EN LA VPS DEJALO EN 0.0.0.0 PARA QUE LOS CLIENTES EXTERNOS PUEDAN CONECTAR
HOST=0.0.0.0

# URL BASE PUBLICA DEL SERVIDOR (para generar links o cuando uses dominio)
# En local: http://localhost:30120
# En VPS:   http://185.230.55.236:30120  o  https://noxxer-api.tudominio.com
SERVER_URL=http://185.230.55.236:30120

# TOKEN DEL BOT DE DISCORD
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ID DE TU SERVIDOR DE DISCORD (para registrar slash commands solo alli)
GUILD_ID=1497050594148483214

# TU ID DE USUARIO EN DISCORD (sera el admin global).
# Aqui te llega por MENSAJE PRIVADO (DM) el codigo de 8 caracteres cada vez que alguien
# abre el escaner. Tu se lo dictas a la persona y ella lo escribe en su ventana.
# Para que el bot pueda escribirte: comparte servidor con el bot y activa
# "Permitir mensajes directos de miembros del servidor" en Discord.
ADMIN_ID=1424539558430769244
# (Opcional) mas admins que tambien reciben el codigo, separados por comas.
# ADMIN_IDS=111111111111111111,222222222222222222

# ======================================================================
#  PANEL WEB DE ADMIN  (pagina /admin para gestionar el enlace de descarga)
# ======================================================================
# Usuario y contraseña con los que entraras en http://TU-SERVIDOR:PUERTO/admin
# Solo se usan la PRIMERA vez que arranca el servidor para crear la cuenta:
# la contraseña se guarda cifrada (hash bcrypt) en la base de datos, nunca en
# texto plano. Despues puedes cambiarla desde el propio panel.
# IMPORTANTE: pon una contraseña fuerte y no la compartas.
ADMIN_USER=noxer
ADMIN_PASSWORD=CAMBIA_ESTA_CONTRASEÑA
